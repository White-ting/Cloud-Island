{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "~/.config/mem/hook.sh start",   "timeout": 8 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.config/mem/hook.sh before",  "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "~/.config/mem/hook.sh after",   "timeout": 8 }] }],
    "PreCompact":       [{ "hooks": [{ "type": "command", "command": "~/.config/mem/hook.sh compact", "timeout": 8 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "~/.config/mem/hook.sh end",     "timeout": 8 }] }]
  }
}
